{
  "name": "@xrblocks/devtools",
  "version": "0.1.0",
  "description": "Developer tools for XR Blocks apps, sessions, agent runs, and visual previews.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "xrblocks-devtools": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./test": "./dist/test/index.js"
  },
  "files": [
    "dist",
    "examples",
    "!examples/**/artifacts",
    "!examples/**/node_modules",
    "docs",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build:xrblocks:sdk": "npm --prefix ../xrblocks run build:sdk",
    "link:xrblocks": "node scripts/link-xrblocks.mjs",
    "link:cli": "npm run build && npm link",
    "setup:local": "npm install && npm run build:xrblocks:sdk && npm run link:xrblocks",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "lint": "eslint src scripts test",
    "format": "npm run format:fix",
    "format:check": "prettier \"**/*.{cjs,html,js,json,md,mdx,ts,css}\" --check",
    "format:fix": "prettier \"**/*.{cjs,html,js,json,md,mdx,ts,css}\" --write",
    "test": "vitest run",
    "test:xrblocks-test": "npm run build && node --test test/xrblocks-test.node-test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "examples": "node scripts/serve-examples.mjs",
    "preeval-test-agent": "npm run build --silent",
    "eval-test-agent": "node scripts/eval-test-agent.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ai": "^7.0.67",
    "esbuild": "^0.27.1",
    "playwright": "^1.61.0",
    "three": "^0.184.0",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/google-vertex": "^5.0.57",
    "three-pathfinding": "^1.3.0",
    "tiny-tts": "^5.0.1",
    "xrblocks": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "three-pathfinding": {
      "optional": true
    },
    "tiny-tts": {
      "optional": true
    },
    "xrblocks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.45",
    "@ai-sdk/google-vertex": "^5.0.57",
    "@eslint/js": "^9.35.0",
    "@pmndrs/uikit": "^1.0.64",
    "@preact/signals-core": "^1.14.0",
    "@types/node": "^25.0.0",
    "@types/three": "^0.184.0",
    "eslint": "^9.35.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^16.4.0",
    "lit": "^3.3.1",
    "prettier": "^3.6.2",
    "three-pathfinding": "^1.3.0",
    "tiny-tts": "^5.0.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.1.4",
    "xrblocks": "^0.21.0"
  }
}
